# ── Grafana ──
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=


# ── Infisical ──
# AES-128 16 bytes: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_SITE_URL=

# Postgres connection string (matches INFISICAL_POSTGRES_* below)
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:<password>@postgres:5432/infisical
INFISICAL_REDIS_URL=redis://redis:6379

# ── Infisical — PostgreSQL ──
INFISICAL_POSTGRES_DATABASE=infisical
INFISICAL_POSTGRES_USER=infisical
INFISICAL_POSTGRES_PASSWORD=

# ── Infisical — SMTP (optional) ──
INFISICAL_SMTP_HOST=
INFISICAL_SMTP_PORT=465
INFISICAL_SMTP_SECURE=true
INFISICAL_SMTP_USERNAME=
INFISICAL_SMTP_PASSWORD=
INFISICAL_SMTP_FROM_NAME=Infisical
INFISICAL_SMTP_FROM_ADDRESS=


# ── Bifrost ──
BIFROST_POSTGRES_DATABASE=bifrost
BIFROST_POSTGRES_USER=bifrost
BIFROST_POSTGRES_PASSWORD=
BIFROST_ADMIN_USERNAME=
BIFROST_ADMIN_PASSWORD=
BIFROST_ENCRYPTION_KEY=

# Bifrost — MCP OAuth apps
BIFROST_GOOGLE_CLIENT_ID=
BIFROST_GOOGLE_CLIENT_SECRET=
BIFROST_SLACK_CLIENT_ID=
BIFROST_SLACK_CLIENT_SECRET=
BIFROST_GITHUB_CLIENT_ID=
BIFROST_GITHUB_CLIENT_SECRET=


# ── n8n ──
N8N_POSTGRES_DATABASE=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=
# Encryption key for n8n credentials. Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
N8N_HOST=n8n.sammaji.com
N8N_WEBHOOK_URL=https://n8n.sammaji.com/
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_ONBOARDING_FLOW_DISABLED=true


# ── Zulip ──
# Public hostname the org will be served at, and the org's admin contact
ZULIP_EXTERNAL_HOST=zulip.sammaji.com
ZULIP_ADMIN_EMAIL=
# Comma-separated auth backends, e.g. EmailAuthBackend,GoogleAuthBackend
ZULIP_AUTH_BACKENDS=EmailAuthBackend

# Outgoing email (invites, notifications, password resets) - optional but strongly recommended
ZULIP_SMTP_HOST=
ZULIP_SMTP_PORT=587
ZULIP_SMTP_USERNAME=

# Secrets required by docker-zulip (names must keep the double underscore - they map
# 1:1 to zulip-secrets.conf). Generate each with: openssl rand -hex 24
ZULIP__POSTGRES_PASSWORD=
ZULIP__MEMCACHED_PASSWORD=
ZULIP__RABBITMQ_PASSWORD=
ZULIP__REDIS_PASSWORD=
# Django secret key. Generate: openssl rand -hex 32
ZULIP__SECRET_KEY=
# SMTP password matching ZULIP_SMTP_USERNAME above (leave blank if not using outgoing email yet)
ZULIP__EMAIL_PASSWORD=


# ── Terraform (optional) ──
# needs Zone:DNS:Edit and Zone:Zone:Read permissions for relevant domains
CLOUDFLARE_API_TOKEN=
