{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "source_of_truth": "config.json",
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "client": {
    "allowed_headers": ["*"],
    "allow_per_request_raw_override": true,
    "allow_per_request_content_storage_override": true,
    "enforce_auth_on_inference": true
  },
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "governance": {
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true,
      "disable_auth_on_inference": true
    }
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras-gpt-key",
          "value": "env.CEREBRAS_API_KEY_01",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "cerebras-gpt-key",
          "value": "env.CEREBRAS_API_KEY_02",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "cerebras-gpt-key",
          "value": "env.CEREBRAS_API_KEY_03",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-key",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "groq": {
      "keys": [
        {
          "name": "groq-gpt-key",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  },
  "mcp": {
    "client_configs": [
      {
        "name": "Calendar",
        "connection_type": "http",
        "connection_string": "https://calendarmcp.googleapis.com/mcp/v1",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth",
        "auth_config": {
          "client_id": "env.BIFROST_GOOGLE_CLIENT_ID",
          "client_secret": "env.BIFROST_GOOGLE_CLIENT_SECRET",
          "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&prompt=consent"
        }
      },
      {
        "name": "Gmail",
        "connection_type": "http",
        "connection_string": "https://gmailmcp.googleapis.com/mcp/v1",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "per_user_oauth",
        "auth_config": {
          "client_id": "env.BIFROST_GOOGLE_CLIENT_ID",
          "client_secret": "env.BIFROST_GOOGLE_CLIENT_SECRET",
          "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&prompt=consent"
        }
      },
      {
        "name": "Slack",
        "connection_type": "http",
        "connection_string": "https://mcp.slack.com/mcp",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth",
        "auth_config": {
          "client_id": "env.BIFROST_SLACK_CLIENT_ID",
          "client_secret": "env.BIFROST_SLACK_CLIENT_SECRET"
        }
      },
      {
        "name": "GitHub",
        "connection_type": "http",
        "connection_string": "https://api.githubcopilot.com/mcp",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth",
        "auth_config": {
          "client_id": "env.BIFROST_GITHUB_CLIENT_ID",
          "client_secret": "env.BIFROST_GITHUB_CLIENT_SECRET"
        }
      },
      {
        "name": "n8n",
        "connection_type": "http",
        "connection_string": "https://n8n.sammaji.com/mcp-server/http",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth"
      },
      {
        "name": "Notion",
        "connection_type": "http",
        "connection_string": "https://mcp.notion.com/mcp",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth"
      },
      {
        "name": "Linear",
        "connection_type": "http",
        "connection_string": "https://mcp.linear.app/mcp",
        "tools_to_execute": ["*"],
        "tool_sync_interval": "-1s",
        "auth_type": "oauth"
      }
    ]
  }
}
