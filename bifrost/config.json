{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "source_of_truth": "config.json",
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "client": {
    "allowed_headers": ["*"],
    "allow_per_request_raw_override": true,
    "allow_per_request_content_storage_override": true,
    "enforce_auth_on_inference": true,
    "mcp_external_client_url": "https://bifrost.sammaji.com"
  },
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "governance": {
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true
    }
  },
  "providers": {
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-key",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "groq": {
      "keys": [
        {
          "name": "groq-gpt-key",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  },
  "mcp": {
    "client_configs": [
      {
        "name": "github",
        "endpoint_slug": "github",
        "connection_type": "http",
        "connection_string": "https://api.githubcopilot.com/mcp/",
        "auth_type": "oauth",
        "oauth_config": {
          "client_id": "env.BIFROST_GITHUB_CLIENT_ID",
          "client_secret": "env.BIFROST_GITHUB_CLIENT_SECRET",
          "scopes": ["repo", "read:org", "read:user"]
        },
        "tools_to_execute": ["*"],
        "allow_by_default": true
      },
      {
        "name": "notion",
        "endpoint_slug": "notion",
        "connection_type": "http",
        "connection_string": "https://mcp.notion.com/mcp",
        "auth_type": "oauth",
        "tools_to_execute": ["*"],
        "allow_by_default": true
      },
      {
        "name": "linear",
        "endpoint_slug": "linear",
        "connection_type": "http",
        "connection_string": "https://mcp.linear.app/mcp",
        "auth_type": "oauth",
        "tools_to_execute": ["*"],
        "allow_by_default": true
      }
    ]
  }
}
