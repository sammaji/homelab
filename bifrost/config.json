{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "source_of_truth": "config.json",
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bifrost-postgres",
      "port": "5432",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "client": {
    "allowed_headers": ["*"],
    "allow_per_request_raw_override": true,
    "allow_per_request_content_storage_override": true,
    "enforce_auth_on_inference": true
  },
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "governance": {
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true,
      "disable_auth_on_inference": true
    }
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras-key-01",
          "value": "env.CEREBRAS_API_KEY_01",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "cerebras-key-02",
          "value": "env.CEREBRAS_API_KEY_02",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "cerebras-key-03",
          "value": "env.CEREBRAS_API_KEY_03",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-key",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "groq": {
      "keys": [
        {
          "name": "groq-gpt-key",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  }
}
